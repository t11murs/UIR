<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/tm_settings.preferences_pb" />
        <exclude domain="file" path="datastore/attachment_downloads.preferences_pb" />
        <exclude domain="file" path="attachment_downloads/" />
        <exclude domain="external" path="Download/UIR/" />
        <exclude domain="database" path="uir_turing.db" />
        <exclude domain="database" path="uir_turing.db-shm" />
        <exclude domain="database" path="uir_turing.db-wal" />
        <exclude domain="database" path="uir_turing.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/tm_settings.preferences_pb" />
        <exclude domain="file" path="datastore/attachment_downloads.preferences_pb" />
        <exclude domain="file" path="attachment_downloads/" />
        <exclude domain="external" path="Download/UIR/" />
        <exclude domain="database" path="uir_turing.db" />
        <exclude domain="database" path="uir_turing.db-shm" />
        <exclude domain="database" path="uir_turing.db-wal" />
        <exclude domain="database" path="uir_turing.db-journal" />
    </device-transfer>
</data-extraction-rules>
